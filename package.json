{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "next lint",
    "start": "next start",
    "seed:forum": "npx tsx scripts/seed-forum.ts",
    "lint:fix": "next lint --fix",
    "lint:strict": "eslint . --ext .ts,.tsx --max-warnings 0",
    "type-check": "tsc --noEmit",
    "type-check:strict": "tsc --noEmit --strict",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "cache:clear": "rm -rf .next && npm run build",
    "quality:check": "npm run type-check:strict && npm run lint:strict && npm run format:check",
    "monitor:data": "npx tsx scripts/monitor-structured-data.ts --once",
    "monitor:data:watch": "npx tsx scripts/monitor-structured-data.ts",
    "monitor:data:fix": "npx tsx scripts/monitor-structured-data.ts --auto-fix",
    "migrate:structured-data": "npx tsx scripts/migrate-structured-data.ts",
    "migrate:structured-data:apply": "npx tsx scripts/migrate-structured-data.ts --apply",
    "test:contracts": "jest tests/structured-data.contract.test.ts",
    "test:utils": "jest tests/structured-data-utils.test.ts",
    "test:structured-data": "npm run test:utils && npm run monitor:data",
    "test": "jest",
    "test:storage": "jest __tests__/storage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check:no-localstorage": "node scripts/check-no-localstorage.js",
    "data:health-check": "npm run monitor:data && npm run test:utils",
    "data:fix": "npx tsx scripts/fix-structured-data.ts",
    "data:monitor-simple": "npx tsx scripts/simple-monitor.ts"
  },
